namespace LaboHH

open LaboBP

/-! ## Lemma 3 (Abel summation) -/

/-- Lemma 3. -/
def lemma3 : Prop :=
  ∀ f c d : ℕ → ℝ, (∀ i j, 1 ≤ i → i ≤ j → f j ≤ f i) → (∀ i, 1 ≤ i → 0 ≤ f i) →
    (∀ n, ∑ i ∈ Finset.Icc 1 n, c i ≤ ∑ i ∈ Finset.Icc 1 n, d i) →
    ∀ n, ∑ i ∈ Finset.Icc 1 n, c i * f i ≤ ∑ i ∈ Finset.Icc 1 n, d i * f i

/-- The stronger assertion of the proof of Lemma 3 (without `f ≥ 0`). -/
def lemma3_strong : Prop :=
  ∀ f c d : ℕ → ℝ, (∀ i j, 1 ≤ i → i ≤ j → f j ≤ f i) →
    (∀ n, ∑ i ∈ Finset.Icc 1 n, c i ≤ ∑ i ∈ Finset.Icc 1 n, d i) →
    ∀ n, ∑ i ∈ Finset.Icc 1 n, c i * f i
      ≤ ∑ i ∈ Finset.Icc 1 n, d i * f i - f n * ∑ i ∈ Finset.Icc 1 n, (d i - c i)

/-! ## Lemma 7 -/

/-- Lemma 7: `M_{l,n}` is strictly increasing in `n` (for `n ≤ l`). -/
def lemma7 : Prop := ∀ l n' n : ℕ, n' < n → n ≤ l → M l n' < M l n

/-- Proof of Lemma 7: `1 s̃(l,n)` dominates `0 s̃(l,n+1)` (prefix sums, `k = 1, …, l+1`). -/
def lemma7_dom : Prop :=
  ∀ l n : ℕ, n + 1 ≤ l → ∀ k, 1 ≤ k → k ≤ l + 1 →
    ((false :: stilde l (n + 1)).take k).count true ≤ ((true :: stilde l n).take k).count true

/-- Proof of Lemma 7: `ϕ(s̃(l,n)) < ϕ(s̃(l,n+1)) − ½·3^n`, times 2. -/
def lemma7_step : Prop :=
  ∀ l n : ℕ, n + 1 ≤ l → 2 * phi (stilde l n) + 3 ^ n < 2 * phi (stilde l (n + 1))

/-! ## Lemma 1 (the half used by Theorem 4) -/

/-- The parity word of the first `l` points of the orbit of `x` under (1): letter `i` (0-based) is `1` iff
`collatzQ^[i] x` is odd (odd reduced numerator). -/
def parityWord (x : ℚ) (l : ℕ) : List Bool :=
  (List.range l).map fun i => decide ((collatzQ^[i] x).num % 2 ≠ 0)

/-- Lemma 1, one half: a Collatz cycle in `ℚ_(2)` (a periodic point `x₀` of (1)) is the pseudo-cycle of its parity
word `s` of length `l` = the minimal period: `x_i = φ_{s₁…s_i}(x₀)` and `x₀ = ϕ(s) / (2^l − 3^{n(s)})`. -/
def lemma1 : Prop :=
  ∀ x₀ : ℚ, Odd x₀.den → x₀ ∈ Function.periodicPts collatzQ →
    0 < Function.minimalPeriod collatzQ x₀ ∧
    (∀ i, i ≤ Function.minimalPeriod collatzQ x₀ →
      collatzQ^[i] x₀ = phiMap ((parityWord x₀ (Function.minimalPeriod collatzQ x₀)).take i) x₀) ∧
    x₀ = (phi (parityWord x₀ (Function.minimalPeriod collatzQ x₀)) : ℚ)
      / (d (parityWord x₀ (Function.minimalPeriod collatzQ x₀)) : ℚ)

/-! ## Theorem 4 -/

/-- `n(l) := ⌊l log₃ 2⌋`. -/
noncomputable def nOf (l : ℕ) : ℕ := ⌊(l : ℝ) * Real.logb 3 2⌋₊

/-- `n(l)` is the largest `n` with `3^n < 2^l` (for `l ≥ 1`). -/
def nOf_spec : Prop := ∀ l : ℕ, 0 < l → 3 ^ nOf l < 2 ^ l ∧ 2 ^ l < 3 ^ (nOf l + 1)

/-- The quotient of Theorem 4, as printed (numerator = Corollary 1 at `n = n(L)`). -/
noncomputable def Q4 (L : ℕ) : ℚ :=
  (((∑ j ∈ Finset.Icc 1 L,
      (cl L (nOf L) j - cl L (nOf L) (j - 1)) * 2 ^ (j - 1) * 3 ^ (nOf L - cl L (nOf L) j)) : ℕ) : ℚ)
    / ((2 : ℚ) ^ L - 3 ^ nOf L)

/-- Bridge: `Q4(L) = M_{L,n(L)} / (2^L − 3^{n(L)})`. -/
def Q4_eq_M : Prop := ∀ L : ℕ, 0 < L → Q4 L = (M L (nOf L) : ℚ) / ((2 : ℚ) ^ L - 3 ^ nOf L)

/-- `L(m)`: the smallest integer `L` with `Q4(L) ≥ m`. -/
noncomputable def Lm (m : ℚ) : ℕ := sInf {L : ℕ | m ≤ Q4 L}

/-- The Collatz cycle generated by `x₀`, as a set (the orbit of `x₀` under (1)). -/
def cycle (x₀ : ℚ) : Set ℚ := Set.range fun i : ℕ => collatzQ^[i] x₀

/-- (11) in the proof of Theorem 3, for `C` generated by its parity word `s ∈ S_{l,n}`, `l = |C|`. -/
def eq11 : Prop :=
  ∀ x₀ : ℚ, Odd x₀.den → x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    ∀ m : ℚ, IsLeast (cycle x₀) m →
    ∀ l n : ℕ, l = Function.minimalPeriod collatzQ x₀ → n = (parityWord x₀ l).count true →
      (0 : ℚ) < (2 : ℚ) ^ l - 3 ^ n ∧
      m ≤ (M l n : ℚ) / ((2 : ℚ) ^ l - 3 ^ n) ∧
      (M l n : ℚ) / ((2 : ℚ) ^ l - 3 ^ n) ≤ (M l (nOf l) : ℚ) / ((2 : ℚ) ^ l - 3 ^ nOf l)

/-- The step behind (12): `min C ≤ Q4(|C|)`. -/
def thm4_core : Prop :=
  ∀ x₀ : ℚ, Odd x₀.den → x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    ∀ m : ℚ, IsLeast (cycle x₀) m → m ≤ Q4 (cycle x₀).ncard

/-- Theorem 4, (12): `|C| ≥ L(min C)` for every positive Collatz cycle `C` in `ℚ_(2)`. -/
def thm4 : Prop :=
  ∀ x₀ : ℚ, Odd x₀.den → x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    (cycle x₀).ncard = Function.minimalPeriod collatzQ x₀ ∧ (∃ m, IsLeast (cycle x₀) m) ∧
    ∀ m : ℚ, IsLeast (cycle x₀) m → Lm m ≤ (cycle x₀).ncard

end LaboHH
