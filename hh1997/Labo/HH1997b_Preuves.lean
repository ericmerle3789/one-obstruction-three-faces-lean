import Mathlib
import Labo.HH1997b_Enonces
import Labo.HH1997_Preuves

/-!
# LABO-COLLATZ · HH1997b · formaliste (2026-10-19) — PROOFS of `Labo/HH1997b_Enonces.lean`

Halbeisen–Hungerbühler 1997, Acta Arith. 78: Lemma 3, Lemma 7, Lemma 1 (one half), Theorem 4.
Every proof is complete and kernel-checked; axiom log: `Labo/HH1997b_Axiomes.lean`.

Reused from the first batch (`Labo/HH1997_Preuves.lean`): `lemma2_fixed_thm`, `orbit_formula` (the points of the
cycle generated by `s` are `ϕ(λ^i s)/(2^l − 3^n)`), `lemma4_thm`, `lemma5_thm`, `cor1_thm`, `phi_cons`,
`stilde_prefix`, `stilde_count`, `cl_le_iff`.  From Mathlib: `Function.minimalPeriod` and its API,
`Real.natFloor_logb_natCast` (`⌊log_b n⌋₊ = Nat.log b n`).
Proof routes: Lemma 3 and Lemma 7 follow the paper.  Theorem 4 has no printed proof; we follow the proof of
Theorem 3, line (11): a positive cycle is generated by its parity word `s ∈ S_{l,n}` (Lemma 1), its points are
`ϕ(λ^i s)/(2^l − 3^n)` (Lemma 2), so `min C ≤ M_{l,n}/(2^l − 3^n)` (definition of `M`), then `≤ M_{l,n(l)}/(2^l − 3^{n(l)})`
(Lemma 7, `n ≤ n(l)`), which is `Q4(l)` (Corollary 1); `L(min C) ≤ l = |C|` by minimality of `L`.
-/

namespace LaboHH

open LaboBP

/-! ## Lemma 3 -/

theorem lemma3_strong_thm : lemma3_strong := by
  intro f c d hf hcd n
  induction n with
  | zero => simp
  | succ n ih =>
    simp only [Finset.sum_Icc_succ_top (show 1 ≤ n + 1 by omega)]
    have hD : 0 ≤ ∑ i ∈ Finset.Icc 1 n, (d i - c i) := by
      rw [Finset.sum_sub_distrib]; linarith [hcd n]
    have hmono : 0 ≤ (∑ i ∈ Finset.Icc 1 n, (d i - c i)) * (f n - f (n + 1)) := by
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · simp
      · exact mul_nonneg hD (by linarith [hf n (n + 1) hn (by omega)])
    nlinarith [ih, hmono]

theorem lemma3_thm : lemma3 := by
  intro f c d hf hf0 hcd n
  have h := lemma3_strong_thm f c d hf hcd n
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  · have hD : 0 ≤ ∑ i ∈ Finset.Icc 1 n, (d i - c i) := by
      rw [Finset.sum_sub_distrib]; linarith [hcd n]
    nlinarith [mul_nonneg (hf0 n hn) hD]

/-! ## Lemma 7 -/

lemma take_cons_count (b : Bool) (u : List Bool) (k : ℕ) (hk : 1 ≤ k) :
    ((b :: u).take k).count true = b.toNat + (u.take (k - 1)).count true := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  rw [List.take_succ_cons, List.count_cons, Nat.add_sub_cancel]
  cases b
  · simp
  · simp; omega

theorem lemma7_dom_thm : lemma7_dom := by
  intro l n hn k hk1 hk2
  have hl : 0 < l := by omega
  rw [take_cons_count _ _ _ hk1, take_cons_count _ _ _ hk1,
    stilde_prefix (n := n + 1) hl hn (k - 1) (by omega), stilde_prefix (n := n) hl (by omega) (k - 1) (by omega)]
  have h1 : (k - 1) * n ≤ cl l n (k - 1) * l := (cl_le_iff hl).mp le_rfl
  have h2 : cl l (n + 1) (k - 1) ≤ cl l n (k - 1) + 1 := by
    rw [cl_le_iff hl]
    have : k - 1 ≤ l := by omega
    nlinarith
  simp only [Bool.toNat_false, Bool.toNat_true]
  omega

theorem lemma7_step_thm : lemma7_step := by
  intro l n hn
  have hl : 0 < l := by omega
  have hn' : n ≤ l := by omega
  have h := lemma4_thm (false :: stilde l (n + 1)) (true :: stilde l n) (by simp [stilde_length])
    (by simp [stilde_count hl hn, stilde_count hl hn']) (by simp)
    (fun k hk1 hk2 => lemma7_dom_thm l n hn k hk1 (by simpa [stilde_length] using hk2))
  rw [phi_cons, phi_cons, stilde_count hl hn'] at h
  simp only [Bool.false_eq_true, ↓reduceIte, zero_add] at h
  omega

lemma M_eq_phi_stilde {l n : ℕ} (hl : 0 < l) (hn : n ≤ l) : M l n = phi (stilde l n) := by
  obtain ⟨-, -, -, -, -, h1, h2⟩ := lemma5_thm l n hl hn
  rw [← h2, ← h1]

lemma M_succ_lt {l n : ℕ} (hn : n + 1 ≤ l) : M l n < M l (n + 1) := by
  have hl : 0 < l := by omega
  rw [M_eq_phi_stilde hl (by omega), M_eq_phi_stilde hl hn]
  have h := lemma7_step_thm l n hn
  have : 0 < 3 ^ n := by positivity
  omega

theorem lemma7_thm : lemma7 := by
  intro l n' n hlt hn
  obtain ⟨k, rfl⟩ : ∃ k, n = n' + 1 + k := ⟨n - (n' + 1), by omega⟩
  clear hlt
  induction k with
  | zero => exact M_succ_lt (by omega)
  | succ k ih => exact (ih (by omega)).trans (M_succ_lt (n := n' + 1 + k) (by omega))

lemma M_mono {l n' n : ℕ} (h : n' ≤ n) (hn : n ≤ l) : M l n' ≤ M l n := by
  rcases h.lt_or_eq with h | rfl
  · exact (lemma7_thm l n' n h hn).le
  · exact le_rfl

/-! ## Lemma 1 (one half) -/

lemma collatzQ_gStep (y : ℚ) : collatzQ y = gStep (decide (y.num % 2 ≠ 0)) y := by
  unfold collatzQ gStep
  by_cases h : y.num % 2 = 0 <;> simp [h]

@[simp] lemma parityWord_length (x : ℚ) (l : ℕ) : (parityWord x l).length = l := by simp [parityWord]

lemma orbit_parity (x : ℚ) (l : ℕ) :
    ∀ i, i ≤ l → collatzQ^[i] x = phiMap ((parityWord x l).take i) x := by
  intro i
  induction i with
  | zero => intro _; simp [phiMap_nil]
  | succ i ih =>
    intro hi
    rw [Function.iterate_succ_apply', ih (by omega),
      List.take_succ_eq_append_getElem (by simp; omega), phiMap_append_singleton, collatzQ_gStep, ← ih (by omega)]
    simp [parityWord]

/-- Lemma 1 without the (unused) hypothesis `Odd x₀.den`. -/
lemma lemma1_core (x₀ : ℚ) (hper : x₀ ∈ Function.periodicPts collatzQ) :
    0 < Function.minimalPeriod collatzQ x₀ ∧
    (∀ i, i ≤ Function.minimalPeriod collatzQ x₀ →
      collatzQ^[i] x₀ = phiMap ((parityWord x₀ (Function.minimalPeriod collatzQ x₀)).take i) x₀) ∧
    x₀ = (phi (parityWord x₀ (Function.minimalPeriod collatzQ x₀)) : ℚ)
      / (d (parityWord x₀ (Function.minimalPeriod collatzQ x₀)) : ℚ) := by
  have hl : 0 < Function.minimalPeriod collatzQ x₀ := Function.minimalPeriod_pos_of_mem_periodicPts hper
  have horb := orbit_parity x₀ (Function.minimalPeriod collatzQ x₀)
  refine ⟨hl, horb, ?_⟩
  generalize hw : parityWord x₀ (Function.minimalPeriod collatzQ x₀) = w at horb
  have hwl : w.length = Function.minimalPeriod collatzQ x₀ := by rw [← hw]; simp
  have hw0 : w ≠ [] := by
    intro h
    rw [h] at hwl
    simp at hwl
    omega
  have hfix : phiMap w x₀ = x₀ := by
    have := horb _ le_rfl
    rw [List.take_of_length_le hwl.le] at this
    rw [← this]
    exact Function.iterate_minimalPeriod
  have hdq : (d w : ℚ) = 2 ^ w.length - 3 ^ w.count true := by simp [LaboBP.d]
  rw [hdq]
  exact ((lemma2_fixed_thm ℚ w hw0).2 x₀).mp hfix

theorem lemma1_thm : lemma1 := fun x₀ _ hper => lemma1_core x₀ hper

/-! ## n(l), Q4 -/

lemma nOf_eq_log (l : ℕ) : nOf l = Nat.log 3 (2 ^ l) := by
  unfold nOf
  rw [← Real.natFloor_logb_natCast]
  congr 1
  push_cast
  rw [Real.logb_pow]

theorem nOf_spec_thm : nOf_spec := by
  intro l hl
  rw [nOf_eq_log]
  have h2 : 2 ^ l ≠ 0 := by positivity
  refine ⟨lt_of_le_of_ne (Nat.pow_log_le_self 3 h2) ?_, Nat.lt_pow_succ_log_self (by norm_num) _⟩
  intro h
  have h3 : Odd (3 ^ Nat.log 3 (2 ^ l)) := Odd.pow (by decide)
  have h4 : Even (2 ^ l) := (Nat.even_pow' hl.ne').mpr even_two
  rw [h] at h3
  exact (Nat.not_even_iff_odd.mpr h3) h4

lemma nOf_le (l : ℕ) : nOf l ≤ l := by
  rw [nOf_eq_log]
  calc Nat.log 3 (2 ^ l) ≤ Nat.log 3 (3 ^ l) := Nat.log_mono_right (Nat.pow_le_pow_left (by norm_num) l)
    _ = l := Nat.log_pow (by norm_num) l

theorem Q4_eq_M_thm : Q4_eq_M := by
  intro L hL
  unfold Q4
  rw [cor1_thm L (nOf L) hL (nOf_le L)]

/-! ## Theorem 4 -/

/-- The points of the cycle generated by `w` are `ϕ(λ^i w)/(2^l − 3^n)` (Lemma 2, `orbit_formula`). -/
lemma cycle_point_aux (x₀ : ℚ) (w : List Bool) (hw : w ≠ [])
    (horb : ∀ i, i ≤ w.length → collatzQ^[i] x₀ = phiMap (w.take i) x₀)
    (hx : x₀ = (phi w : ℚ) / (d w : ℚ)) (i : ℕ) (hi : i ≤ w.length) :
    collatzQ^[i] x₀ = (phi (w.rotate i) : ℚ) / (d w : ℚ) := by
  rw [horb i hi, hx]
  exact orbit_formula w hw i hi

lemma cycle_eq (x₀ : ℚ) (hper : x₀ ∈ Function.periodicPts collatzQ) :
    cycle x₀ = ↑((Finset.range (Function.minimalPeriod collatzQ x₀)).image fun i => collatzQ^[i] x₀) := by
  ext y
  simp only [cycle, Set.mem_range, Finset.coe_image, Finset.coe_range, Set.mem_image, Set.mem_Iio]
  constructor
  · rintro ⟨j, rfl⟩
    exact ⟨j % _, Nat.mod_lt _ (Function.minimalPeriod_pos_of_mem_periodicPts hper),
      Function.iterate_mod_minimalPeriod_eq⟩
  · rintro ⟨j, -, rfl⟩
    exact ⟨j, rfl⟩

lemma cycle_ncard (x₀ : ℚ) (hper : x₀ ∈ Function.periodicPts collatzQ) :
    (cycle x₀).ncard = Function.minimalPeriod collatzQ x₀ := by
  rw [cycle_eq x₀ hper, Set.ncard_coe_finset, Finset.card_image_of_injOn, Finset.card_range]
  rw [Finset.coe_range]
  exact Function.iterate_injOn_Iio_minimalPeriod

lemma cycle_min_exists (x₀ : ℚ) (hper : x₀ ∈ Function.periodicPts collatzQ) :
    ∃ m, IsLeast (cycle x₀) m := by
  rw [cycle_eq x₀ hper]
  have hne : ((Finset.range (Function.minimalPeriod collatzQ x₀)).image fun i => collatzQ^[i] x₀).Nonempty :=
    (Finset.nonempty_range_iff.mpr (Function.minimalPeriod_pos_of_mem_periodicPts hper).ne').image _
  exact ⟨_, Finset.isLeast_min' _ hne⟩

theorem eq11_thm : eq11 := by
  intro x₀ _ hper hpos m hm l n hl hn
  obtain ⟨hl0, horb, hx⟩ := lemma1_core x₀ hper
  rw [← hl] at hl0 horb hx
  generalize hw : parityWord x₀ l = w at horb hx hn
  have hwl : w.length = l := by rw [← hw]; simp
  rw [hwl.symm] at horb hl0
  have hw0 : w ≠ [] := by
    intro h; rw [h] at hl0; simp at hl0
  have hpt := cycle_point_aux x₀ w hw0 horb hx
  have hnl : n ≤ l := by rw [hn, ← hwl]; exact List.count_le_length
  have hdq : (d w : ℚ) = 2 ^ l - 3 ^ n := by rw [hn, ← hwl]; simp [LaboBP.d]
  -- the denominator is positive (the cycle is positive)
  have hdpos : (0 : ℚ) < d w := by
    have hx0 : 0 < x₀ := hpos x₀ ⟨0, rfl⟩
    have hD0 : (d w : ℚ) ≠ 0 := by exact_mod_cast d_ne_zero w hw0
    by_contra h
    have : (phi w : ℚ) / (d w : ℚ) ≤ 0 := div_nonpos_of_nonneg_of_nonpos (by positivity) (not_lt.mp h)
    linarith
  refine ⟨hdq ▸ hdpos, ?_, ?_⟩
  · -- min C ≤ minRot w / (2^l − 3^n) ≤ M l n / (2^l − 3^n)
    have hne : (phi '' sigma w).Nonempty :=
      ⟨phi w, w, ⟨w.length, hl0, le_rfl, (List.rotate_length w).symm⟩, rfl⟩
    obtain ⟨t, ⟨k, hk1, hk2, rfl⟩, hk⟩ := Nat.sInf_mem hne
    have hmin : phi (w.rotate k) = minRot w := hk
    have hS : w ∈ Sln l n := ⟨hwl, hn.symm⟩
    obtain ⟨-, -, -, -, hgreat, h1, h2⟩ := lemma5_thm l n (by omega) hnl
    have hle : minRot w ≤ M l n := by
      rw [← h2, ← h1]
      exact hgreat.2 ⟨w, hS, rfl⟩
    have hmk : m ≤ collatzQ^[k] x₀ := hm.2 ⟨k, rfl⟩
    rw [hpt k hk2, hmin] at hmk
    rw [← hdq]
    calc m ≤ (minRot w : ℚ) / (d w : ℚ) := hmk
      _ ≤ (M l n : ℚ) / (d w : ℚ) := div_le_div_of_nonneg_right (by exact_mod_cast hle) hdpos.le
  · -- n ≤ n(l), Lemma 7, and 0 < 2^l − 3^{n(l)} ≤ 2^l − 3^n
    have hlpos : 0 < l := by omega
    have hlt : (3 : ℚ) ^ n < 2 ^ l := by linarith [hdq ▸ hdpos]
    have hlt' : 3 ^ n < 2 ^ l := by exact_mod_cast hlt
    have hnn : n ≤ nOf l := by
      rw [nOf_eq_log]
      exact Nat.le_log_of_pow_le (by norm_num) hlt'.le
    obtain ⟨hs1, -⟩ := nOf_spec_thm l hlpos
    have hs1' : (3 : ℚ) ^ nOf l < 2 ^ l := by exact_mod_cast hs1
    have hM := M_mono hnn (nOf_le l)
    have h3 : (3 : ℚ) ^ n ≤ 3 ^ nOf l := pow_le_pow_right₀ (by norm_num) hnn
    exact div_le_div₀ (by positivity) (by exact_mod_cast hM) (by linarith) (by linarith)

theorem thm4_core_thm : thm4_core := by
  intro x₀ hodd hper hpos m hm
  have hl0 := Function.minimalPeriod_pos_of_mem_periodicPts hper
  obtain ⟨-, h1, h2⟩ := eq11_thm x₀ hodd hper hpos m hm _ _ rfl rfl
  rw [cycle_ncard x₀ hper, Q4_eq_M_thm _ hl0]
  exact h1.trans h2

theorem thm4_thm : thm4 := by
  intro x₀ hodd hper hpos
  refine ⟨cycle_ncard x₀ hper, cycle_min_exists x₀ hper, fun m hm => ?_⟩
  exact Nat.sInf_le (thm4_core_thm x₀ hodd hper hpos m hm)

end LaboHH
