namespace LaboHH

open LaboBP

/-! ## The product formula -/

/-- `2^l = Π (3 + 1/x)` over the odd points `x` of one period of a positive cycle. -/
def prod_formula : Prop :=
  ∀ x₀ : ℚ, x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    (2 : ℚ) ^ Function.minimalPeriod collatzQ x₀
      = ∏ i ∈ (Finset.range (Function.minimalPeriod collatzQ x₀)).filter
            (fun i => (collatzQ^[i] x₀).num % 2 ≠ 0),
          (3 + 1 / collatzQ^[i] x₀)

/-- `3^n < 2^l ≤ (3 + 1/min C)^n`, `n` = the number of odd points of one period. -/
def prod_ineq : Prop :=
  ∀ x₀ : ℚ, x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    ∀ m : ℚ, IsLeast (cycle x₀) m →
      (3 : ℚ) ^ (parityWord x₀ (Function.minimalPeriod collatzQ x₀)).count true
          < 2 ^ Function.minimalPeriod collatzQ x₀ ∧
      (2 : ℚ) ^ Function.minimalPeriod collatzQ x₀
          ≤ (3 + 1 / m) ^ (parityWord x₀ (Function.minimalPeriod collatzQ x₀)).count true

/-! ## Lemma 8 (Crandall) -/

/-- Lemma 8. -/
def lemma8 : Prop :=
  ∀ (l n : ℕ) (s : List Bool), s ∈ Sln l n → n ≤ nOf l →
    ∀ m : ℚ, 1 < m → IsLeast (cycle ((phi s : ℚ) / (d s : ℚ))) m →
      m < n * (3 + 1 / m) ^ (n - 1) / ((2 : ℚ) ^ l - 3 ^ n)

/-- Lemma 8 for any minimum, when `n ≥ 2` (stronger than printed). -/
def lemma8_gen : Prop :=
  ∀ (l n : ℕ) (s : List Bool), s ∈ Sln l n → 2 ≤ n → n ≤ nOf l →
    ∀ m : ℚ, IsLeast (cycle ((phi s : ℚ) / (d s : ℚ))) m →
      m < n * (3 + 1 / m) ^ (n - 1) / ((2 : ℚ) ^ l - 3 ^ n)

/-! ## Theorem 1 (Crandall) -/

/-- `θ = log₂ 3`. -/
noncomputable def theta : ℝ := Real.logb 2 3

/-- `q_k`, the denominators of the convergents of `log₂ 3` (Mathlib's indexing, `q₀ = 1`). -/
noncomputable def qCF (k : ℕ) : ℝ := (GenContFract.of theta).dens k

/-- Theorem 1 (for `k ≥ 4` in Mathlib's indexing = the paper's `k > 4`). -/
def thm1 : Prop :=
  ∀ k : ℕ, 4 ≤ k → ∀ (l n : ℕ) (s : List Bool), s ∈ Sln l n → n ≤ nOf l →
    ∀ m : ℚ, 1 < m → IsLeast (cycle ((phi s : ℚ) / (d s : ℚ))) m →
      min (qCF k) (2 * (m : ℝ) / (qCF k + qCF (k + 1))) < n

/-- The continued-fraction fact used by Theorem 1: `|qθ − p| > 1/(q_k + q_{k+1})` for `1 ≤ q ≤ q_k`. -/
def cf_gap (k : ℕ) : Prop :=
  ∀ p q : ℤ, 1 ≤ q → (q : ℝ) ≤ qCF k → 1 / (qCF k + qCF (k + 1)) < |(q : ℝ) * theta - p|

/-- Sizes: `q_k + q_{k+1} ≥ 18` for `k ≥ 5` (Fibonacci lower bound). -/
def cf_size : Prop := ∀ k : ℕ, 5 ≤ k → 18 ≤ qCF k + qCF (k + 1)

/-- Theorem 1, conditional on the continued-fraction facts that Mathlib v4.34 does not provide. -/
def thm1_cond : Prop := (∀ k : ℕ, 4 ≤ k → cf_gap k) → 18 ≤ qCF 4 + qCF 5 → thm1

/-! ## Theorem 2 (Eliahou) -/

/-- `k(m)`: the smallest integer `k` (with `n(k) ≥ 1`) such that `k/n(k) ≤ log₂(3 + 1/m)`. -/
noncomputable def kE (m : ℝ) : ℕ :=
  sInf {k : ℕ | 1 ≤ nOf k ∧ (k : ℝ) / nOf k ≤ Real.logb 2 (3 + 1 / m)}

/-- Theorem 2: for every Collatz cycle `C` in ℕ, `|C| ≥ k(min C)`. -/
def thm2 : Prop :=
  ∀ x₀ : ℕ, 0 < x₀ → (x₀ : ℚ) ∈ Function.periodicPts collatzQ →
    ∀ m : ℚ, IsLeast (cycle (x₀ : ℚ)) m → kE m ≤ (cycle (x₀ : ℚ)).ncard

/-- Theorem 2 for every positive cycle in `ℚ_(2)` (stronger than printed). -/
def thm2_gen : Prop :=
  ∀ x₀ : ℚ, x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    ∀ m : ℚ, IsLeast (cycle x₀) m → kE m ≤ (cycle x₀).ncard

/-! ## Theorem 3 (Eliahou improved) -/

/-- `α = 0.9`. -/
noncomputable def alphaHH : ℝ := 9 / 10

/-- Theorem 3. -/
def thm3 : Prop :=
  ∀ x₀ : ℚ, Odd x₀.den → x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    160 < (cycle x₀).ncard →
    ∀ m : ℚ, IsLeast (cycle x₀) m → kE ((m : ℝ) / alphaHH) ≤ (cycle x₀).ncard

/-- The displayed line of the proof of Theorem 3 (Prop. 2 + Lemma 6, merged). -/
def thm3_line : Prop :=
  ∀ l : ℕ, 160 < l →
    (M l (nOf l) : ℝ) / ((2 : ℝ) ^ l - 3 ^ nOf l) ≤ alphaHH * ((2 : ℝ) ^ ((l : ℝ) / nOf l) - 3)⁻¹

/-- The last display of the proof of Theorem 3, from `thm3_line`. -/
def thm3_last : Prop :=
  thm3_line →
  ∀ x₀ : ℚ, Odd x₀.den → x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    160 < (cycle x₀).ncard →
    ∀ m : ℚ, IsLeast (cycle x₀) m →
      ((cycle x₀).ncard : ℝ) / nOf (cycle x₀).ncard ≤ Real.logb 2 (3 + alphaHH / m)

/-- Theorem 3, conditional on `thm3_line`. -/
def thm3_cond : Prop := thm3_line → thm3

/-! ## The word "optimal" before Theorem 4 -/

/-- At length 3 no positive cycle reaches equality in (12): the only one is `{1/5, 2/5, 4/5}`, and `L(1/5) = 2`. -/
def opt_counterexample : Prop :=
  (Odd (1 / 5 : ℚ).den ∧ (1 / 5 : ℚ) ∈ Function.periodicPts collatzQ ∧ (∀ y ∈ cycle (1 / 5), 0 < y) ∧
    cycle (1 / 5) = {1 / 5, 2 / 5, 4 / 5} ∧ (cycle (1 / 5)).ncard = 3 ∧ Lm (1 / 5) = 2) ∧
  ∀ x₀ : ℚ, Odd x₀.den → x₀ ∈ Function.periodicPts collatzQ → (∀ y ∈ cycle x₀, 0 < y) →
    (cycle x₀).ncard = 3 →
    cycle x₀ = {1 / 5, 2 / 5, 4 / 5} ∧ ∀ m : ℚ, IsLeast (cycle x₀) m → Lm m < (cycle x₀).ncard

end LaboHH
